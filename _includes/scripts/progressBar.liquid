{% if site.enable_progressbar %}
  <!-- Scrolling Progress Bar -->
  <script type="text/javascript">
    const progressBar = document.getElementById('progress');

    function getDistanceToScroll() {
      return Math.max(document.documentElement.scrollHeight - window.innerHeight, 0);
    }

    function updateProgressBar() {
      if (!progressBar) return;
      progressBar.max = getDistanceToScroll();
      progressBar.value = window.scrollY;
    }

    function progressBarSetup() {
      if (!progressBar) return;
      const navbar = document.getElementById('navbar');
      const navbarHeight = navbar ? navbar.getBoundingClientRect().height : 0;
      document.body.style.paddingTop = `${navbarHeight}px`;
      progressBar.style.top = `${navbarHeight}px`;
      updateProgressBar();
    }

    window.addEventListener('load', () => setTimeout(progressBarSetup, 50));
    document.addEventListener('scroll', updateProgressBar, { passive: true });
    window.addEventListener('resize', progressBarSetup);
  </script>
{% endif %}
